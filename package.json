{
  "name": "@oliverames/sprout-mcp-server",
  "version": "1.3.1",
  "description": "MCP server for Sprout Social API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sprout-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm run build && npm test && npm audit --omit=dev --audit-level=high && npm pack --dry-run",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "start": "node dist/index.js",
    "login": "tsc && node dist/login.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "sprout-social",
    "social-media",
    "analytics",
    "model-context-protocol"
  ],
  "author": "Oliver Ames",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverames/sprout-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "open": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
